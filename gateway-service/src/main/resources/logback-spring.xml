<configuration>
    <springProperty scope="context" name="springAppName" source="spring.application.name" defaultValue="gateway-service"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level ${springAppName} %logger{36} [trace=%X{traceId:-} span=%X{spanId:-}] [corrId=%X{correlationId:-none}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
